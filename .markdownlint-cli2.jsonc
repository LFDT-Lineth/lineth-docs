{
  "globs": ["docs/**/*.md"],
  "config": {
    "default": true,
    "MD001": false,
    "MD012": false,
    // 200-character lines are allowed. The cap is 600 because some glossary
    // definitions are a single longer line, and markdownlint does not reflow them.
    "MD013": {
      "line_length": 600,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD024": false,
    "MD037": false,
    "MD025": false,
    "MD026": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,
    "MD049": false,
    "MD050": false,
    "MD051": false,
    "MD052": false,
    "MD053": false,
    "MD058": false,
    "MD060": false
  }
}
